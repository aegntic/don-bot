{
  "name": "don-bot",
  "version": "0.1.0-alpha.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.3.0"
  },
  "bin": {
    "don": "./packages/cli/src/index.ts"
  },
  "scripts": {
    "don": "bun run packages/cli/src/index.ts",
    "test": "bun test",
    "test:crash": "bun test tests/chaos/01-sigkill-replay.test.ts",
    "lint": "bunx oxlint packages tests",
    "fmt": "bunx oxfmt packages tests",
    "fmt:check": "bunx oxfmt --check packages tests",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.19.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^5.9.0"
  }
}
